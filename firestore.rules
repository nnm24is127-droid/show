rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'rizwanarahiman135@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().status == 'approved')
      );
    }

    function isStallEmployee() {
      return isApprovedUser() && getUserData().role == 'stall_employee';
    }

    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile; Super Admin can view all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());

      // New users can create their own profile ONLY with 'viewer' role and 'pending' status
      // Super Admin can create any profile
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId &&
         request.auth.token.email != null &&
         request.resource.data.email != null &&
         request.resource.data.email.lower() == request.auth.token.email.lower() &&
         request.resource.data.role == 'viewer' &&
         request.resource.data.status == 'pending')
      );

      // Only the Super Admin can update approval status, roles, stall assignment, or disable accounts
      allow update: if isSuperAdmin();

      // Only Super Admin can delete user documents
      allow delete: if isSuperAdmin();
    }

    // Business Data: Expos
    match /expos/{expoId} {
      allow read: if isApprovedUser();
      allow write: if isSuperAdmin();
    }

    // Business Data: Leads
    match /leads/{leadId} {
      allow read: if isApprovedUser();
      allow create: if isSuperAdmin() || (isStallEmployee() && request.resource.data.createdByUid == request.auth.uid);
      allow update: if isSuperAdmin() || (isStallEmployee() && (resource.data.createdByUid == request.auth.uid || resource.data.stallName == getUserData().assignedStall));
      allow delete: if isSuperAdmin();
    }

    // Business Data: Orders
    match /orders/{orderId} {
      allow read: if isApprovedUser();
      allow create: if isSuperAdmin() || (isStallEmployee() && request.resource.data.createdByUid == request.auth.uid);
      allow update: if isSuperAdmin() || (isStallEmployee() && (resource.data.createdByUid == request.auth.uid || resource.data.stallName == getUserData().assignedStall));
      allow delete: if isSuperAdmin();
    }
  }
}
