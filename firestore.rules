rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'rizwanarahiman135@gmail.com';
    }

    function hasUserProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserProfile() && getUserData().status == 'approved')
      );
    }

    function isViewer() {
      return isApproved() && !isSuperAdmin() && (
        !('role' in getUserData()) ||
        getUserData().role == 'viewer'
      );
    }

    function isStallEmployee() {
      return isApproved() && !isSuperAdmin() &&
        hasUserProfile() &&
        'role' in getUserData() &&
        getUserData().role == 'stall_employee' &&
        'assignedStall' in getUserData() &&
        getUserData().assignedStall is string &&
        getUserData().assignedStall.size() > 0 &&
        'assignedExpo' in getUserData() &&
        getUserData().assignedExpo is string &&
        getUserData().assignedExpo.size() > 0;
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile; Super Admin can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());

      // New registrations can only create a pending viewer profile for their own UID
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId &&
         request.auth.token.email != null &&
         request.resource.data.email != null &&
         request.resource.data.email.lower() == request.auth.token.email.lower() &&
         request.resource.data.role == 'viewer' &&
         request.resource.data.status == 'pending')
      );

      // Only Super Admin can approve, reject, assign roles/stalls, or disable users
      // Employees cannot change their own roles or stall assignments
      allow update: if isSuperAdmin();

      // Only Super Admin can delete user profiles
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. Expos Collection
    // ==========================================
    match /expos/{expoId} {
      // Approved company users can read expos
      allow read: if isApproved();

      // Only Super Admin can create, modify, or delete expos
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 3. Leads Collection
    // ==========================================
    match /leads/{leadId} {
      // 1. Super Admin and Viewers have company-wide read access
      // 2. Stall Employees can read ONLY leads belonging to their assigned stall and expo
      allow read: if isSuperAdmin() ||
                     isViewer() ||
                     (isStallEmployee() &&
                      resource.data.stallName == getUserData().assignedStall &&
                      resource.data.expo == getUserData().assignedExpo);

      // 3. Stall Employees can create leads ONLY for their assigned stall and expo
      // 4. createdByUid and createdByEmail must strictly match the authenticated user
      allow create: if isSuperAdmin() || (
        isStallEmployee() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.email &&
        request.resource.data.stallName == getUserData().assignedStall &&
        request.resource.data.expo == getUserData().assignedExpo &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0
      );

      // 5. Employees must NOT modify records belonging to other employees merely because they share a stall
      //    (resource.data.createdByUid must match request.auth.uid)
      // 6. Ownership, stall, expo, and administrative fields are strictly immutable
      allow update: if isSuperAdmin() || (
        isStallEmployee() &&
        resource.data.createdByUid == request.auth.uid &&
        resource.data.stallName == getUserData().assignedStall &&
        resource.data.expo == getUserData().assignedExpo &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdByEmail == resource.data.createdByEmail &&
        request.resource.data.stallName == resource.data.stallName &&
        request.resource.data.expo == resource.data.expo &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'email', 'company', 'interest', 'source', 'status', 'notes', 'city'
        ])
      );

      // Viewers and Stall Employees cannot delete leads
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 4. Orders Collection
    // ==========================================
    match /orders/{orderId} {
      // 1. Super Admin and Viewers have company-wide read access
      // 2. Stall Employees can read ONLY orders belonging to their assigned stall and expo
      allow read: if isSuperAdmin() ||
                     isViewer() ||
                     (isStallEmployee() &&
                      resource.data.stallName == getUserData().assignedStall &&
                      resource.data.expoId == getUserData().assignedExpo);

      // 3. Stall Employees can create orders ONLY for their assigned stall and expo
      // 4. createdByUid and createdByEmail must strictly match the authenticated user
      allow create: if isSuperAdmin() || (
        isStallEmployee() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.email &&
        request.resource.data.stallName == getUserData().assignedStall &&
        request.resource.data.expoId == getUserData().assignedExpo &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() > 0 &&
        request.resource.data.product is string && request.resource.data.product.size() > 0 &&
        request.resource.data.qty is number && request.resource.data.qty > 0 &&
        request.resource.data.unitPrice is number && request.resource.data.unitPrice > 0 &&
        request.resource.data.finalTotal is number && request.resource.data.finalTotal >= 0
      );

      // 5. Employees must NOT modify orders belonging to other employees merely because they share a stall
      //    (resource.data.createdByUid must match request.auth.uid)
      // 6. Employees CANNOT change financial fields (pricing, quantity, discount, total), payment status, order ID, ownership, stall, or expo
      // 7. Explicitly defined permitted transport and delivery fields ONLY
      allow update: if isSuperAdmin() || (
        isStallEmployee() &&
        resource.data.createdByUid == request.auth.uid &&
        resource.data.stallName == getUserData().assignedStall &&
        resource.data.expoId == getUserData().assignedExpo &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdByEmail == resource.data.createdByEmail &&
        request.resource.data.stallName == resource.data.stallName &&
        request.resource.data.expoId == resource.data.expoId &&
        (!('orderId' in resource.data) || request.resource.data.orderId == resource.data.orderId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deliveryStatus', 'stage', 'log', 'tr', 'notes', 'customerAddress', 'dest'
        ])
      );

      // Viewers and Stall Employees cannot delete orders
      allow delete: if isSuperAdmin();
    }
  }
}
